{
  "manifest_version": 3,
  "name": "IDNML Mapping Uploader",
  "version": "1.5",
  "description": "Extract bidder/slot mappings from pages and upload to Supabase.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "*://*.independent.co.uk/*",
    "*://*.the-independent.com/*",
    "*://*.standard.co.uk/*",
    "*://*.huffingtonpost.co.uk/*",
    "*://*.buzzfeed.com/*"
  ],
  "action": {
    "default_title": "Mapping Checker",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.independent.co.uk/*",
        "*://*.the-independent.com/*",
        "*://*.standard.co.uk/*",
        "*://*.huffingtonpost.co.uk/*",
        "*://*.buzzfeed.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": [
        "*://*.independent.co.uk/*",
        "*://*.the-independent.com/*",
        "*://*.standard.co.uk/*",
        "*://*.huffingtonpost.co.uk/*",
        "*://*.buzzfeed.com/*"
      ]
    }
  ]
}